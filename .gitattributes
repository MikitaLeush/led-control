# Normalise to LF in the repo. The Android build runs on a Linux CI runner, and a
# CRLF gradlew fails there with "bad interpreter: No such file or directory".
* text=auto eol=lf

# Never touch these.
*.png binary
*.jpg binary
*.apk binary
*.keystore binary
*.jar binary
android/gradlew text eol=lf
android/gradlew.bat text eol=crlf
