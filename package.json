{
  "name": "led-control",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Desktop and Android control for Lotus Lantern and iStrip+ BLE LED strips",
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\"",
    "build:singlefile": "node scripts/build-singlefile.mjs",
    "serve": "node scripts/serve.mjs",
    "start": "electron electron/main.js",
    "sync:vendor": "node scripts/sync-vendor.mjs",
    "sync:android": "npm run sync:vendor && npx cap sync android"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "electron": "^44.3.0"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^8.3.0",
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2"
  }
}
